{
  "name": "peerpages-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The PeerPages app shell plus a hand-written Service Worker (Vite + TypeScript, no framework)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check . && npm run typecheck",
    "format": "biome check --write .",
    "build:pages": "node scripts/build.mjs /PeerPages/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "nostr-tools": "^2.25.2"
  }
}
